{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=App_Data/fidoco.db",
    "MigrateOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "MaxAttempts": 10
  },
  "Platform": {
    "Hosts": [
      "admin.fidoco.se"
    ]
  },
  "PublicUrls": {
    "Template": "https://{host}"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "noreply@fidoco.se",
    "FromDisplaySuffix": " via Fidoco",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true
    }
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "CheckoutPerMinute": 10,
    "PlaybackTokenPerMinute": 10,
    "HeartbeatPerMinute": 6
  },
  "Video": {
    "Provider": "Mux"
  },
  "Mux": {
    "TokenId": "",
    "TokenSecret": "",
    "WebhookSecret": "",
    "LatencyMode": "standard",
    "ReconnectWindowSeconds": 300
  }
}
