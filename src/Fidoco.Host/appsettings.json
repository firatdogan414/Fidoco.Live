{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=App_Data/fidoco.db",
    "MigrateOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "MaxAttempts": 10
  }
}
